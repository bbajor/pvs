# Beispiel .env Datei für lokale Entwicklung
# Kopiere diese Datei zu podman-compose.dev.env und passe die Werte an

# PostgreSQL Configuration für lokale Entwicklung
POSTGRES_DB_DEV=pvs_dev
POSTGRES_USER_DEV=pvs_user
POSTGRES_PASSWORD_DEV=dev_password_local_only_123

# SMTP Mail Server Configuration
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USERNAME=bjoern.bajor@a-or.de
SMTP_FROM_ADDRESS=bjoern.bajor@a-or.de
SMTP_SECURITY_METHOD=SSL_TLS

# Optional: Übersteuere andere Variablen
# PORT=8200
# SPRING_PROFILES_ACTIVE=dev

