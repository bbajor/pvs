# Beispiel .env Datei für lokale Entwicklung
# Kopiere diese Datei zu podman-compose.dev.env und passe die Werte an

# PostgreSQL Configuration für lokale Entwicklung
POSTGRES_DB_DEV=pvs_dev
POSTGRES_USER_DEV=pvs_user
POSTGRES_PASSWORD_DEV=dev_password_local_only_123

# SMTP Mail Server Configuration
# Diese Werte werden als Fallback verwendet, wenn keine DB-Konfiguration vorhanden ist
# Passwort und Private Key werden aus Sicherheitsgründen NICHT aus ENV gelesen
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_SECURITY_METHOD=STARTTLS
# SMTP_ENABLED=true  # Optional: Standardmäßig aktiviert

# Optional: Übersteuere andere Variablen
# PORT=8080
# SPRING_PROFILES_ACTIVE=dev

