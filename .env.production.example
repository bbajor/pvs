# Production Environment Variables
# Kopiere diese Datei zu .env und setze die Werte

# ========================
# Domain & SSL
# ========================
DOMAIN=pvs.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ========================
# PostgreSQL Production
# ========================
POSTGRES_DB_PROD=pvs_prod
POSTGRES_USER_PROD=pvs_user
POSTGRES_PASSWORD_PROD=CHANGE_ME_STRONG_PASSWORD_HERE

# ========================
# PostgreSQL Dev
# ========================
POSTGRES_DB_DEV=pvs_dev
POSTGRES_USER_DEV=pvs_user
POSTGRES_PASSWORD_DEV=dev_password_123

# ========================
# PostgreSQL Test
# ========================
POSTGRES_DB_TEST=pvs_test
POSTGRES_USER_TEST=pvs_user
POSTGRES_PASSWORD_TEST=test_password_123

# ========================
# Docker Registry
# ========================
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=bbajor/pvs

# ========================
# AI Services (optional)
# ========================
AI_API_KEY=

# ========================
# Traefik Dashboard Auth
# ========================
# Generiere neues Passwort mit: htpasswd -nb admin your-password
# Dann ersetze den Wert in docker/traefik/dynamic/middlewares.yml
