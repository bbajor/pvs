# OIDC (SPA Auth Code + PKCE)
VITE_OIDC_AUTHORITY=https://your-idp.example/realms/pvs
VITE_OIDC_CLIENT_ID=pvs-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# Optional: set for cross-origin API deployment (e.g., Cloud Run)
# Keep empty for same-origin reverse proxy setups.
VITE_API_BASE_URL=

