[Unit]
Description=IVOMPlaner On-Premise Application
Documentation=https://github.com/bbajor/pvs
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=pvs
Group=pvs
WorkingDirectory=/opt/pvs
EnvironmentFile=/opt/pvs/.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/pvs/app/pvs-app.jar'
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pvs /var/log/pvs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pvs-onpremise

[Install]
WantedBy=multi-user.target

