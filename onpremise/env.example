# PVS OnPremise Environment Variables
# Kopiere diese Datei nach .env und passe die Werte an

# ============================================
# Datenbank-Konfiguration (ERFORDERLICH)
# ============================================
POSTGRES_DB=pvs
POSTGRES_USER=pvs
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# KBV Master Data Database
KBV_DB_NAME=kbv
KBV_DB_USER=kbv
KBV_DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ============================================
# Application-Konfiguration
# ============================================
SPRING_PROFILES_ACTIVE=onpremise
PORT=8080
APP_PORT=8080

# ============================================
# SMTP-Konfiguration (optional)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM_ADDRESS=noreply@example.com

# ============================================
# Secrets (ERFORDERLICH für verschlüsselte SMTP-Passwörter)
# ============================================
# Generiere mit: openssl rand -base64 32 | head -c 32
# WICHTIG: Dieser Schlüssel muss sicher gespeichert werden!
SMTP_ENCRYPTION_KEY=

# ============================================
# AI/Whisper (optional)
# ============================================
# Lokalen Whisper-Container aktivieren (benötigt mehr Ressourcen)
AI_WHISPER_LOCAL_ENABLED=false

# ============================================
# MFA-Konfiguration
# ============================================
MFA_ISSUER=PVS

# ============================================
# OnPremise: Automatischer Institutionscode (optional)
# ============================================
# Falls gesetzt, wird dieser Institutionscode automatisch beim Login verwendet
# und das Institutionscode-Feld in der LoginView ausgeblendet.
# Der Anwender muss dann nicht jedes Mal die Institution angeben.
# Beispiel: ONPREMISE_INSTITUTION_CODE=PRAX-001
ONPREMISE_INSTITUTION_CODE=