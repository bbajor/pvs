# IVOMPlaner On-Premise environment
# Copy this file to /etc/ivomplaner/ivomplaner.env and adjust the values.

# Application
SPRING_PROFILES_ACTIVE=onpremise
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
IVOMPLANER_HOME=/opt/ivomplaner
IVOMPLANER_CONFIG=/etc/ivomplaner/ivomplaner.env

# PostgreSQL on the same host
POSTGRES_DB=pvs
POSTGRES_USER=pvs
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_URL=jdbc:postgresql://127.0.0.1:5432/pvs
DB_USER=pvs
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Required if SMTP passwords are stored encrypted.
# Generate with: openssl rand -base64 32 | tr -d '\n'
SMTP_ENCRYPTION_KEY=

# Optional local Whisper service. Native on-premise deployment does not manage it.
AI_WHISPER_LOCAL_ENABLED=false
AI_WHISPER_LOCAL_HOST=127.0.0.1
AI_WHISPER_LOCAL_PORT=9000

# MFA
MFA_ISSUER=IVOMPlaner

# Optional: hides the institution field on login and always uses this code.
ONPREMISE_INSTITUTION_CODE=

# Optional bootstrap password. Leave empty to generate one on first startup.
# If set, remove it from this file after the first login.
SUPER_ADMIN_INITIAL_PASSWORD=

# Optional release source used by ivomplaner-update.
RELEASE_ARTIFACT_URL=

# App-initiated update integration. The installer configures sudoers
# for /usr/local/bin/ivomplaner-update-wrapper.
APP_UPDATE_ENABLED=true
APP_UPDATE_LATEST_VERSION_URL=https://github.com/bbajor/pvs/releases/latest/download/VERSION
APP_UPDATE_COMMAND=sudo -n /usr/local/bin/ivomplaner-update-wrapper latest