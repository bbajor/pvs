# Beispiel .env Datei für lokale Entwicklung
# Kopiere diese Datei zu docker-compose.dev.env und passe die Werte an

# PostgreSQL Configuration für lokale Entwicklung
POSTGRES_DB_DEV=pvs_dev
POSTGRES_USER_DEV=pvs_user
POSTGRES_PASSWORD_DEV=dev_password_local_only_123

# Optional: Übersteuere andere Variablen
# PORT=8080
# SPRING_PROFILES_ACTIVE=dev

